{
  "name": "neurex-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Neurex Mobile MVP - React Native test automation platform",
  "scripts": {
    "dev": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "detox test --configuration ios.sim.release --record-logs all",
    "test:e2e:build": "detox build-framework-cache && detox build-app --configuration ios.sim.release",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "build:ios": "cd ios && xcodebuild -scheme NeurexMobile -configuration Release -derivedDataPath build",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "prebuild": "expo prebuild --clean",
    "codegen": "react-native codegen",
    "bundle:ios": "react-native bundle --entry-file index.js --platform ios --dev false --reset-cache --bundle-output ios/main.jsbundle",
    "bundle:android": "react-native bundle --entry-file index.js --platform android --dev false --reset-cache --bundle-output android/app/src/main/assets/index.android.bundle"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.5",
    "react-navigation": "^5.x",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.6.0",
    "react-native-screens": "^3.27.0",
    "axios": "^1.6.0",
    "@reduxjs/toolkit": "^1.9.7",
    "react-redux": "^8.1.3",
    "redux": "^4.2.1",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "react-native-keychain": "^8.1.0",
    "react-native-biometrics": "^3.1.3",
    "react-native-web-view": "^13.6.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-svg": "^14.1.0",
    "react-native-charts-wrapper": "^0.16.0",
    "react-native-image-resizer": "^3.0.8",
    "react-native-webview": "^13.6.0",
    "react-query": "^3.39.3",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-native": "^5.0.0",
    "zustand": "^4.4.2",
    "immer": "^10.0.3",
    "lodash": "^4.17.21",
    "dayjs": "^1.11.10",
    "expo": "^50.0.0",
    "expo-secure-store": "^13.0.0",
    "expo-splash-screen": "^0.26.0",
    "expo-status-bar": "^1.7.0",
    "expo-font": "^11.4.0",
    "expo-linking": "^6.2.0",
    "expo-web-browser": "^13.0.0",
    "expo-auth-session": "^5.4.0",
    "react-native-config": "^1.5.1",
    "rn-fetch-blob": "^0.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.8",
    "@types/react-native": "^0.73.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "babel-jest": "^30.4.1",
    "detox": "^20.18.0",
    "detox-cli": "^20.18.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "metro": "^0.78.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "xcode": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
