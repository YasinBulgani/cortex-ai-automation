# ═══════════════════════════════════════════════════════════════════════════════
# Neurex — Merkezi Ortam Değişkenleri
#
# Kullanım:
#   cp .env.example .env
#   # Ardından tüm CHANGEME değerlerini gerçek değerlerle doldurun
#   # .env dosyasını asla git'e commit etmeyin
#
# Güvenli secret üretimi:
#   openssl rand -base64 64   →  JWT_SECRET için
#   openssl rand -hex 32      →  ENGINE_INTERNAL_KEY, GATEWAY_INTERNAL_KEY için
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                             →  SECRETS_ENCRYPTION_KEYS için
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Ortam ───────────────────────────────────────────────────────────────────
# "development" | "staging" | "production"
APP_ENV=development
DEBUG=false

# ─── Ürün Markası (tek kaynak — UX-F1-105) ──────────────────────────────────
# Frontend + Backend bu iki değişkeni aynı tutar; rebrand tek yerden yapılır.
# Boş bırakılırsa frontend ve backend "Neurex" default'ına düşer.
APP_NAME=Neurex
NEXT_PUBLIC_APP_NAME=Neurex

# ─── Veritabanı (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://neurex_user:CHANGEME_DB_PASSWORD@127.0.0.1:5432/syndata_db
POSTGRES_USER=neurex_user
POSTGRES_PASSWORD=CHANGEME_use_openssl_rand_hex_32   # ZORUNLU — prod'da güçlü şifre
POSTGRES_DB=syndata_db
# Production'da Redis bağlantısı zorunlu (multi-instance deployment)
REQUIRE_REDIS_IN_PRODUCTION=true

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGEME_use_openssl_rand_hex_32   # ZORUNLU — prod/staging'de boş bırakılamaz
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0
DOCKER_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ─── Backend JWT ve Oturum ────────────────────────────────────────────────────
# KRİTİK: Prod/staging'de mutlaka değiştirin (min 64 karakter)
# Üretim: openssl rand -base64 64
JWT_SECRET=CHANGEME-minimum-64-chars-use-openssl-rand-base64-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# "Beni hatırla" seçeneği için uzun TTL (dakika cinsinden — 7 gün = 10080)
ACCESS_TOKEN_EXPIRE_MINUTES_REMEMBER_ME=10080
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
ALLOW_SELF_REGISTRATION=false

# CORS: Prod'da gerçek domain ile kısıtlayın
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ─── Secrets at-rest Şifrelemesi (Fernet) ────────────────────────────────────
# KRİTİK: Veritabanında şifrelenen veriler (API key, token, credential) için.
# Prod'da boş bırakılırsa şifreleme atlanır — güvensiz!
# Üretim: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotasyon: yeni key'i başa ekle, virgülle ayır → eski veriler hâlâ açılabilir.
SECRETS_ENCRYPTION_KEYS=

# ─── Dahili Güvenlik Anahtarları ─────────────────────────────────────────────
ENGINE_INTERNAL_KEY=CHANGEME-engine-internal-key    # openssl rand -hex 32
GATEWAY_INTERNAL_KEY=CHANGEME-gateway-internal-key  # openssl rand -hex 32

# ─── Engine (Flask — port 5001) ──────────────────────────────────────────────
ENGINE_PORT=5001
ENGINE_BASE_URL=http://127.0.0.1:5001
ENGINE_SECRET_KEY=CHANGEME-engine-secret-key   # openssl rand -hex 32
# "true" → engine erişilemezse /ready 503 döner (Kubernetes için önerilen)
ENGINE_REQUIRED_FOR_READY=true

# ─── AI Gateway (opsiyonel — port 8080) ─────────────────────────────────────
AI_GATEWAY_BASE_URL=http://127.0.0.1:8080
AI_GATEWAY_REQUIRED=false
AI_BUDGET_PREFLIGHT_REQUIRED=false
AI_STRUCTURED_OUTPUT_FAIL_CLOSED=false

# ─── Artifact Depolama ───────────────────────────────────────────────────────
# "local" → disk (dev/tek sunucu)  |  "s3" → AWS S3 / MinIO (multi-instance)
ARTIFACT_STORAGE_BACKEND=local
ARTIFACTS_DIR=./data/artifacts
# S3 — yalnızca ARTIFACT_STORAGE_BACKEND=s3 iken kullanılır
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=          # MinIO/Localstack için override; boş = AWS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=artifacts/

# ─── Background Job Kuyrukları ────────────────────────────────────────────────
RQ_QUEUE_NAME=syndata_jobs
AI_RQ_QUEUE_NAME=ai_workflows
AI_WORKFLOW_ARTIFACT_RETENTION_DAYS=30
# "auto" | "rq" | "background"
AGENTS_V2_QUEUE_BACKEND=auto

# ─── Tarayıcı Otomasyon ─────────────────────────────────────────────────────
BROWSER=chromium
HEADLESS=true
BASE_URL=https://example.com
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000

# ─── CI/CD Entegrasyonu ──────────────────────────────────────────────────────
CI_TRIGGER_TOKEN=CHANGEME-ci-trigger-token   # openssl rand -hex 32
# Production: openssl rand -hex 32 ile degistir
# CICD_REQUIRE_WEBHOOK_SECRETS=true  # production'da aktif et
CICD_REQUIRE_WEBHOOK_SECRETS=false
N8N_REQUIRE_CALLBACK_SECRET=false
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_TOKEN=
JENKINS_WEBHOOK_TOKEN=

# ─── Neurex Farm (Mobil Test) ────────────────────────────────────────────────
MOBILE_ARTIFACTS_DIR=./mobile_uploads
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_BUILD="Neurex Farm Build"
BROWSERSTACK_PROJECT="Neurex Mobile Operations"
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_REGION=eu-central

# ─── Frontend (Next.js — port 3000) ─────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_ENGINE_BASE=/api/v1/automation/proxy
# Prod'da:
# NEXT_PUBLIC_API_BASE=https://api.example.com
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=false
NEXT_PUBLIC_AUTH_MIDDLEWARE_ENABLED=true

# ─── SSO / OAuth (OIDC) ──────────────────────────────────────────────────────
# Google SSO: console.cloud.google.com → APIs & Services → Credentials
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
# Azure AD SSO: portal.azure.com → App registrations
SSO_AZURE_TENANT_ID=
SSO_AZURE_CLIENT_ID=
SSO_AZURE_CLIENT_SECRET=
# true → SSO ile giriş yapan yeni kullanıcı otomatik provisionlanır
SSO_AUTO_PROVISION=true
# Virgülle ayrılmış izin verilen e-posta domain'leri (boş = tümüne izin)
SSO_ALLOWED_EMAIL_DOMAINS=

# ─── Stripe (Faturalama) ──────────────────────────────────────────────────────
# Boş bırakılırsa checkout/portal endpoint'leri 503 döner.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=http://localhost:3000/admin/billing?status=success
STRIPE_CANCEL_URL=http://localhost:3000/admin/billing?status=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/admin/billing

# ─── Nexus Repo Modülü ────────────────────────────────────────────────────────
NEXUS_REPO_ENABLED=false

# ─── AI / LLM ────────────────────────────────────────────────────────────────
# Sağlayıcı seçimi: "openai" | "anthropic" | "ollama" | "groq" | "gateway"
AI_PROVIDER=ollama
ALLOW_PROVIDER_FALLBACK=false
# Enterprise güvenlik: müşteri verisi dış LLM endpoint'lerine gitmesin (false = git)
AI_LOCAL_ONLY=true
# Routing stratejisi: cost_optimized | balanced | quality_first
AI_ROUTING_MODE=balanced
AI_MAX_CONTEXT_MESSAGES=20
AI_PROMPT_REGISTRY_ENABLED=true

# ── Tiered Model Alias'ları ────────────────────────────────────────────────
# smart_model_router.py tarafından MINI / MID / PREMIUM / LOCAL tier'larına çevrilir
OPENAI_MINI_MODEL=gpt-4o-mini
OPENAI_MID_MODEL=gpt-4o
ANTHROPIC_PREMIUM_MODEL=claude-sonnet-4-20250514
OLLAMA_FALLBACK_MODEL=qwen2.5:32b

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Groq (ücretsiz: https://console.groq.com)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama3-70b-8192
GROQ_ENABLED=false   # Groq API key olmadan false bırakın; key varsa true yapın

# Gemini (ücretsiz: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_ENABLED=false   # Gemini API key olmadan false bırakın; key varsa true yapın

# Ollama (yerel LLM)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_ENABLED=true
OLLAMA_MODEL_ANALYST=qwen2.5:32b
OLLAMA_MODEL_FAST=mistral:latest
OLLAMA_MODEL_CODER=qwen2.5-coder:7b
OLLAMA_MODEL_CHAT=mistral:latest
OLLAMA_NUM_CTX_CHAT=4096

# ─── AI Erişilebilirlik Analizi (opsiyonel) ──────────────────────────────────
AI_ACCESSIBILITY_ENABLED=false
AI_ACCESSIBILITY_MAX_VIOLATIONS=10
AI_ACCESSIBILITY_TEMPERATURE=0.2

# ─── AI DSL Semantic Search Reranker (opsiyonel) ─────────────────────────────
AI_MODEL_RERANKER_ENABLED=false
AI_MODEL_RERANKER=seroe/bge-reranker-v2-m3-turkish-triplet
AI_MODEL_RERANKER_TOP_K_IN=20
AI_MODEL_RERANKER_TOP_K_OUT=5
AI_MODEL_RERANKER_DEVICE=cpu   # cpu | cuda | mps

# ─── AI Arka Plan Ops Servisi ─────────────────────────────────────────────────
AI_BACKGROUND_ENABLED=false   # config.py default: false; production'da true yapın
AI_BACKGROUND_INTERVAL_SECONDS=900
AI_BACKGROUND_START_DELAY_SECONDS=60
AI_BACKGROUND_REQUEST_TIMEOUT_SECONDS=5.0
AI_BACKGROUND_TARGETS=backend=http://localhost:8000/health,engine=http://localhost:5001/health
AI_BACKGROUND_REPORT_PATH=./data/reports/ai_ops_latest.md

# ─── Nexus AI Autopilot ───────────────────────────────────────────────────────
NEXUS_AUTOPILOT_ENABLED=false
# "observe" → sadece izle  |  "act" → güvenli aksiyonları otomatik uygula
NEXUS_AUTOPILOT_BACKGROUND_MODE=observe
NEXUS_AUTOPILOT_INTERVAL_SECONDS=900
NEXUS_AUTOPILOT_START_DELAY_SECONDS=45
NEXUS_AUTOPILOT_APPLY_SAFE_ACTIONS=true
NEXUS_AUTOPILOT_MAX_PROJECTS_PER_TICK=20

# ─── n8n (İş Akışı Otomasyonu) ───────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# ─── Monitoring & Observability ─────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development   # development | staging | production
SENTRY_TRACES_SAMPLE_RATE=0.1   # Prod'da 0.05-0.1 önerilir
# Sentry release tracking — CI/CD'de set edin: APP_VERSION=$(git rev-parse --short HEAD)
APP_VERSION=
PROMETHEUS_ENABLED=false         # Prod'da true
GRAFANA_ADMIN_PASSWORD=
ALERTMANAGER_WEBHOOK_URL=
G4F_ENABLED=false

# ─── E-posta ─────────────────────────────────────────────────────────────────
# "console" (dev) | "memory" (test) | "smtp" (prod)
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@testwright.ai
APP_PUBLIC_URL=http://localhost:3000
# SMTP — yalnızca EMAIL_BACKEND=smtp iken kullanılır
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=           # sender.py'de SMTP_USER olarak okunur
SMTP_PASSWORD=
SMTP_TLS=true        # sender.py'de SMTP_TLS olarak okunur

# ─── Rate Limiting (backend) ─────────────────────────────────────────────────
# Varsayılanlar: login 5/dakika, register 3/dakika, default 60/dakika
# Dev'de artırabilirsiniz; prod'da varsayılana yakın kalın.
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_REGISTER=3/minute
# RATE_LIMIT_DEFAULT=60/minute

# ─── Security Scanning ───────────────────────────────────────────────────────
SEMGREP_APP_TOKEN=

# ─── Eval / Quality Reports ──────────────────────────────────────────────────
ENGINE_EVAL_REPORTS_DIR=
EVAL_REPORTS_DIR=

# ─── Bildirim Kanalları ────────────────────────────────────────
SLACK_WEBHOOK_URL=                    # https://hooks.slack.com/services/T.../B.../...
SLACK_DEFAULT_CHANNEL=#notifications  # Varsayılan Slack kanalı
SLACK_BOT_TOKEN=                      # xoxb-... (opsiyonel, bot API için)
TEAMS_WEBHOOK_URL=                    # https://outlook.office.com/webhook/...
PUSH_NOTIFICATIONS_ENABLED=false
VAPID_PRIVATE_KEY=                    # openssl ecparam -name prime256v1 -genkey -noout -out vk.pem && openssl ec -in vk.pem -no_public
VAPID_PUBLIC_KEY=                     # openssl ec -in vk.pem -pubout
VAPID_CLAIMS_EMAIL=admin@neurex.app
